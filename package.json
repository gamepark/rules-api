{
  "name": "@gamepark/rules-api",
  "version": "7.6.3",
  "description": "API to implement the rules of a board game",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "yarn build",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "publish": "npm version ${0:-patch} && yarn npm publish && git push && git push --tags"
  },
  "keywords": [
    "Game Park",
    "Board games",
    "Rules"
  ],
  "author": "Romain Fromi <romain@game-park.com> (https://game-park.com/)",
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "es-toolkit": "^1.46.0",
    "i18next": "^26.0.8",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "es-toolkit": "^1.46.0"
  },
  "packageManager": "yarn@4.9.4"
}
